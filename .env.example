# FreightX Environment Variables Example
# Duplicate this file to .env and configure the variables below.

# =========================================================================
# 1. EVM Smart Contract Deployer & Agent Private Key
# =========================================================================
# Private key used for deploying smart contracts and running the automated IoT oracle agent on Arc Testnet.
# DO NOT use mainnet keys! Always prepend with "0x" (64 hex characters after).
# The account MUST have testnet USDC to pay for gas (since Arc uses USDC as the native gas token).
# Fund your wallet address at the Circle Faucet: https://faucet.circle.com (select Arc Testnet).
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY_HERE

# Optional: Dedicated private key for the automated IoT coordinator agent (falls back to PRIVATE_KEY if blank)
AGENT_PRIVATE_KEY=

# =========================================================================
# 2. Blockchain RPC URL Configuration
# =========================================================================
# Default public RPC endpoint for Arc Testnet (Circle's USDC-gas native network)
# Chain ID: 5042002. Explorer: https://testnet.arcscan.app
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# =========================================================================
# 3. Circle Developer Platform (Modular Passkey Wallets & Paymaster Sponsorship)
# =========================================================================
# Client Key (Public Key) obtained from the Circle Developer Console (Programmable Wallets section)
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=mock_client_key_for_testing

# Circle Client endpoint URL. Default for Sandbox/Testnet is: https://api.circle.com/v1/w3s
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://api.circle.com/v1/w3s

# Circle Developer Console API Key (kept secret, backend/server-side usage)
CIRCLE_API_KEY=your-circle-api-key

# Circle webhook verification secret to authenticate incoming transaction notifications
CIRCLE_WEBHOOK_SECRET=your-circle-webhook-secret

# =========================================================================
# 4. Supabase Database Configuration (PostgreSQL Backend)
# =========================================================================
# Set to 'https://your-supabase-url.supabase.co' to fallback to local in-memory store.
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# =========================================================================
# 5. Circle Gateway Nanopayments (x402 Protocol)
# =========================================================================
# Seller/Merchant wallet address that receives the nanopayment streams (pre-funded or EIP-3009 signed)
GATEWAY_SELLER_ADDRESS=0x9b1C51cEF8bc8757ad757845ef80A390a3b9d194
NEXT_PUBLIC_GATEWAY_SELLER_ADDRESS=0x9b1C51cEF8bc8757ad757845ef80A390a3b9d194

# Circle Gateway API Key
GATEWAY_API_KEY=your-gateway-api-key

# =========================================================================
# 6. Circle StableFX Configuration
# =========================================================================
# API Key for stablecoin FX conversions (e.g., EURC/USDC conversions for global corridor rates)
STABLEFX_API_KEY=YOUR_STABLEFX_API_KEY

# =========================================================================
# 7. Pinata IPFS (Document Minting & Freight Passports)
# =========================================================================
# Pinata credentials used to upload and pin bill of lading documents and cold-chain logs to IPFS.
# If left blank, the application automatically falls back to local storage simulation.
NEXT_PUBLIC_PINATA_JWT=
NEXT_PUBLIC_PINATA_API_KEY=
NEXT_PUBLIC_PINATA_SECRET_KEY=
